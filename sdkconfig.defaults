# Raw BLE bridge — sdkconfig defaults
# Single ESP32-S3: custom raw BLE peripheral + USB CDC-ACM monome composite

# BLE — NimBLE stack only (no classic BT)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_MODE_BLE_ONLY=y

# NimBLE roles: peripheral only (iPad connects TO us)
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# NimBLE max connections: 1 (one iPad at a time)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# Negotiate maximum ATT MTU for largest possible payloads (247 bytes usable)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=48
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=36
CONFIG_BT_NIMBLE_TRANSPORT_ACL_SIZE=255

# Keep stress-test hot paths quiet by default.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_MAXIMUM_LEVEL=3
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# USB OTG — TinyUSB in device mode (connects to norns)
CONFIG_TINYUSB_RHPORT_HS_ENABLED=n

# Flash: use default 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
